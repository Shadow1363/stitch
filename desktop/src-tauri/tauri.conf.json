{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stitch",
  "version": "0.1.0",
  "identifier": "games.stitch.editor",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../packages/editor/dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Stitch", "width": 1400, "height": 900 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
