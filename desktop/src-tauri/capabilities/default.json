{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The editor window. Every host still needs the user's OK in the editor's own prompt, once per cart.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
