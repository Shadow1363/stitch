  push(rows, "..............###....o..........")
  push(rows, ".........o....###...###........F")
  push(rows, ".P......###...###...###.o^^e...|")
  push(rows, "#####...###...###...############")
  push(rows, "#####...###...###...############")
  push(rows, "#####^^^###^^^###^^^############")
