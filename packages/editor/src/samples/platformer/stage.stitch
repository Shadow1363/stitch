  push(rows, "...................===..........")
  push(rows, "................o...............")
  push(rows, ".........o.......e.............F")
  push(rows, "..............#####.....e.o....|")
  push(rows, ".......#####..#####......#######")
  push(rows, ".P.....#####..########...#######")
  push(rows, "############..########...#######")
  push(rows, "############..########...#######")
