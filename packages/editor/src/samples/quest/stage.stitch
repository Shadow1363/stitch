  push(rows, "T.........::::.........TT.....,...::::.........TT......................T")
  push(rows, "T....*....::::.........TT.~~~~~~..::::..~~~~~~.TT..T...T........T...T..T")
  push(rows, "T..*..e...::::...*.....TT.~~~~~~..::::..~~~~~~.TT....T.......,....T....T")
  push(rows, "T......*..::::.....*...TT.~~~~~~..::::..~~~~~~.TT.......,..............T")
  push(rows, "T........,::::.........TT....,....::::.........TT..T.....,.......T..T..T")
  push(rows, "T.........::::::::::::::::::e:::::::::::e:::::::::::::::::::::....,....T")
  push(rows, "T..TTT....::::::::::::::::::::::::::::::::::::::::::::::::::::.........T")
  push(rows, "T..TTT....::::::::::::::::::::::::::::::::::::::::::::::::::::....e..,.T")
  push(rows, "T..,......::::::::::::::::::::::::::::::::::::::::::::::::::::.........T")
