  push(rows, "T...*..,..::::..*.e....TT.~~~~~~e.::::..~~~~~~.TT..T...e..::::.........T")
  push(rows, "T.........::::......*..TT.~~~~~~..::::..~~~~~~,TT.....T...::::...e..T..T")
  push(rows, "T....,....::::.........TT...,.....::::.........TT.........::::..,......T")
  push(rows, "TTTTTTTTTT::::TTTTTTTTTTTTTTTTTTTT::::TTTTTTTTTTTTTTTTTTTT::::TTTTTTTTTT")
  push(rows, "TTTTTTTTTT::::TTTTTTTTTTTTTTTTTTTT::::TTTTTTTTTTTTTTTTTTTT::::TTTTTTTTTT")
  push(rows, "T.........::::..,......TT.........::::.........TT....,....::::...,.....T")
